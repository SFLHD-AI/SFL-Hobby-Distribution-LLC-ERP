# Copy to .env (gitignored). Never commit the real key.
TPX_API_KEY=tp_live_xxxxxxxxxxxxxxxxxxxxxxxx
# TPX_GRAPHQL_URL=https://platform-api.tradepost.co/graphql

# sealed_wax | sealed_tcg | both
VERTICAL=both
# manual | csv | scrape   (scrape backend is not built until you confirm it)
DEALERNET_ACCESS=manual
# basic | vendor  (listed-price trades 0%; name-your-price / counter 3%)
DEALERNET_PLAN=vendor

# Shipping assumptions, USD per physical move of one unit
SHIPPING_BOX_USD=15
SHIPPING_CASE_USD=45
HANDLING_USD=0

# Target margin on capital deployed (0.08 = 8%)
TARGET_MARGIN=0.08

# Risk flags
STALE_DAYS=7
THIN_BOOK_UNITS=3

# Optional: pin TPX asset type IDs once discovered (edge doctor prints them)
# TPX_ASSET_TYPE_SEALED_WAX=
# TPX_ASSET_TYPE_SEALED_TCG=
