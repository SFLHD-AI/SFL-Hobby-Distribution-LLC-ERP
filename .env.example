# ============================================================
# SFL ERP System environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Django core ---------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. Your domain(s) and/or server IP.
DJANGO_ALLOWED_HOSTS=cards.example.com
# Required when behind HTTPS, e.g. https://cards.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://cards.example.com

# --- Database (docker compose fills host automatically) ------
POSTGRES_DB=sfl_erp
POSTGRES_USER=sfl_erp
POSTGRES_PASSWORD=pick-a-strong-password
# POSTGRES_HOST=db        # set automatically in docker-compose
# POSTGRES_PORT=5432

# --- Redis (background jobs broker) --------------------------
# REDIS_HOST=redis        # set automatically in docker-compose
# REDIS_PORT=6379

# --- Email (SMTP) — invoices, statements, tracking, digests --
# Leave EMAIL_HOST empty to print emails to the console (dev mode).
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-password-or-api-key
DEFAULT_FROM_EMAIL=orders@yourdomain.com

# --- ShipStation (full API integration) ----------------------
# Get keys: ShipStation -> Settings -> Account -> API Settings
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# SHIPSTATION_BASE_URL=https://ssapi.shipstation.com

# --- Shippo (buy USPS/UPS/FedEx labels via API) ----------------
# Get a token: goshippo.com -> Settings -> API -> Generate Token
# (use the LIVE token for real labels; TEST tokens create sample labels)
# Can also be entered on the in-app Settings screen.
SHIPPO_API_TOKEN=

# --- uShip (freight/LTL) --------------------------------------
# Requires a uShip partner/API account. Leave blank to use the
# built-in manual-entry workflow (create listing on uship.com,
# paste reference + cost back into SFL ERP System).
USHIP_API_KEY=
# USHIP_BASE_URL=https://api.uship.com

# NOTE: Pirate Ship has no API on purpose — use the batch CSV
# export + tracking paste-back built into the Shipping screen.

# --- Misc ------------------------------------------------------
# Q_WORKERS=2
# BACKUP_DIR=backups
